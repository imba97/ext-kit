{
  "name": "@ext-kit/monorepo",
  "type": "module",
  "version": "0.0.4",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "description": "Shared building blocks for Manifest V3 browser extensions.",
  "license": "MIT",
  "homepage": "https://github.com/imba97/ext-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imba97/ext-kit.git"
  },
  "bugs": {
    "url": "https://github.com/imba97/ext-kit/issues"
  },
  "scripts": {
    "stub": "pnpm -r run stub",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "tu": "vitest -u",
    "lint": "eslint --cache",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.3",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bumpp": "^12.3.0",
    "defu": "^6.1.7",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue,json,jsonc,json5,md,css,scss,less,html}": "eslint --cache --fix"
  }
}
