{
  "name": "@ext-kit/scripts",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@12.8.1",
  "description": "Build scripts for extension projects: manifest writer, view html stub, env helpers",
  "license": "MIT",
  "homepage": "https://github.com/imba97/ext-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imba97/ext-kit.git"
  },
